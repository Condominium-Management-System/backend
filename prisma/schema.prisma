datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  resident
  condo_admin
  guard
  super_admin
}

enum RoomModel {
  studio
  one_bedroom
  two_bedroom
  three_bedroom
}

enum RoomStatus {
  free
  occupied
  reserved
}

enum EqubStatus {
  pending
  active
  completed
  cancelled
}

enum EqubMemberStatus {
  active
  inactive
  suspended
  winner
}

enum EqubPayoutStatus {
  pending
  selected
  processing
  paid
  failed
}

enum IddirStatus {
  active
  inactive
}

enum IddirMemberStatus {
  active
  inactive
  suspended
}

enum ActiveInactiveStatus {
  active
  inactive
}

enum PaymentType {
  iddir
  equb
  guard_fee
  service_charge
  other
}

enum PaymentStatus {
  pending
  approved
  rejected
}

enum PaymentMethod {
  cbe
  telebirr
  cash
  bank_transfer
  others
}

enum TransactionStatus {
  pending
  completed
  failed
  reversed
}

enum AccountType {
  bank
  mobile_money
  wallet
}

enum AccountStatus {
  active
  inactive
  blocked
}

enum PaymentGateway {
  hx
}

enum ServiceFeeStatus {
  pending
  collected
  refunded
}

enum AnnouncementType {
  general
  shop_alert
  emergency
  event
  mourning
  celebration
}

enum CreatorRole {
  admin
  guard
  resident
  super_admin
}

enum ReportCategory {
  plumbing
  electrical
  structural
  security
  noise
  other
}

enum ReportStatus {
  reported
  assigned
  in_progress
  resolved
  closed
}

enum ReportPriority {
  low
  medium
  high
  emergency
}

enum LostFoundType {
  lost
  found
}

enum LostFoundCategory {
  electronics
  documents
  keys
  clothing
  jewelry
  other
}

enum LostFoundStatus {
  open
  matched
  claimed
  archived
}

enum ChatType {
  message
  photo
  file
}

enum PromoStatus {
  pending
  approved
  active
  expired
  rejected
  cancelled
}

enum PromoType {
  shop
  technical
  service
  product
  event
  other
}

model User {
  id                   String           @id @default(uuid())
  fullName             String
  email                String           @unique
  phoneNumber          String           @unique
  password             String
  role                 Role             @default(resident)
  condoId              String?
  condoCode            String?
  condo                Condo?           @relation(fields: [condoId], references: [id], onDelete: SetNull)
  block                String?
  roomNo               String?
  isVerified           Boolean          @default(false)
  profilePhoto         String?
  fan                  String           @unique @db.VarChar(16)
  revenue              Decimal?         @db.Decimal(15, 2)
  frontId              String?
  backId               String?
  isInIddir            Boolean          @default(false)
  isInEqub             Boolean          @default(false)
  isGetEqub            Boolean          @default(false)
  refreshToken         String?          @unique
  resetPasswordToken   String?          @unique
  resetPasswordExpires DateTime?
  emailVerifyToken     String?          @unique
  emailVerifyExpires   DateTime?
  registerDate         DateTime         @default(now())
  dueDate              DateTime?
  addToEqubById        String?
  addToEqubBy          User?            @relation("UserAddToEqub", fields: [addToEqubById], references: [id], onDelete: SetNull)
  addedEqubUsers       User[]           @relation("UserAddToEqub")
  addToIddirById       String?
  addToIddirBy         User?            @relation("UserAddToIddir", fields: [addToIddirById], references: [id], onDelete: SetNull)
  addedIddirUsers      User[]           @relation("UserAddToIddir")
  bankAccounts         UserAccount[]
  equbMemberships      EqubMember[]
  iddirMemberships     IddirMember[]
  equbPayouts          EqubPayout[]
  paymentsMade         Payment[]        @relation("PaymentUser")
  paymentsApproved     Payment[]        @relation("PaymentApprover")
  sentTransactions     Transaction[]    @relation("SenderTransaction")
  receivedTransactions Transaction[]    @relation("ReceiverTransaction")
  serviceFees          ServiceFee[]
  announcements        Announcement[]   @relation("AnnouncementCreator")
  reportsReported      Report[]         @relation("ReportReporter")
  reportsAssigned      Report[]         @relation("ReportAssignee")
  lostFoundReported    LostFound[]      @relation("LostFoundUser")
  lostFoundClaimed     LostFound[]      @relation("LostFoundClaimant")
  lostFoundVerified    LostFound[]      @relation("LostFoundVerifier")
  sentMessages         ChatMessage[]    @relation("ChatSender")
  receivedMessages     ChatMessage[]    @relation("ChatReceiver")
  promotionsPosted     Promotion[]      @relation("PromotionPoster")
  promotionsReviewed   Promotion[]      @relation("PromotionReviewer")
  reportResponses      ReportResponse[]
  createdEqubs         Equb[]           @relation("EqubCreator")
  createdIddirs        Iddir[]          @relation("IddirCreator")
  createdPayouts       EqubPayout[]     @relation("PayoutCreator")
  rooms                Room[]           @relation("RoomOccupant")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  @@index([condoId])
  @@index([condoCode])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Condo {
  id               String         @id @default(uuid())
  condoCode        String         @unique @db.VarChar(50)
  condoName        String
  address          String
  city             String?
  gpsCoordinates   Json?
  maxAdmins        Int            @default(3)
  blockNumbers     String[]
  activeStatus     Boolean        @default(true)
  customSettings   Json?
  registrationDate DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  users            User[]
  blocks           Block[]
  rooms            Room[]
  equibs           Equb[]
  iddirs           Iddir[]
  payments         Payment[]
  transactions     Transaction[]
  serviceFees      ServiceFee[]
  accounts         CondoAccount[]
  announcements    Announcement[]
  reports          Report[]
  lostAndFound     LostFound[]
  chatMessages     ChatMessage[]
  promotions       Promotion[]

  @@index([deletedAt])
  @@map("condos")
}

model Block {
  id             String    @id @default(uuid())
  condoId        String
  condo          Condo     @relation(fields: [condoId], references: [id], onDelete: Cascade)
  blockNo        String
  noRooms        Int
  noFloors       Int
  availableRooms Int       @default(0)
  occupiedRooms  Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  rooms          Room[]

  @@unique([condoId, blockNo])
  @@index([condoId])
  @@map("blocks")
}

model Room {
  id           String     @id @default(uuid())
  condoId      String
  condo        Condo      @relation(fields: [condoId], references: [id], onDelete: Cascade)
  blockId      String
  block        Block      @relation(fields: [blockId], references: [id], onDelete: Cascade)
  roomNo       String
  floorNo      Int
  price        Decimal    @db.Decimal(15, 2)
  model        RoomModel
  status       RoomStatus @default(free)
  occupiedById String?
  occupiedBy   User?      @relation("RoomOccupant", fields: [occupiedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@unique([blockId, roomNo])
  @@index([condoId])
  @@index([blockId])
  @@index([occupiedById])
  @@map("rooms")
}

model Equb {
  id                 String       @id @default(uuid())
  condoId            String
  condo              Condo        @relation(fields: [condoId], references: [id], onDelete: Cascade)
  createdById        String
  createdBy          User         @relation("EqubCreator", fields: [createdById], references: [id], onDelete: Restrict)
  name               String
  noMembers          Int          @default(0)
  status             EqubStatus   @default(pending)
  startDate          DateTime
  dueDate            DateTime
  contributionAmount Decimal      @db.Decimal(15, 2)
  members            EqubMember[]
  payouts            EqubPayout[]
  payments           Payment[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  @@index([condoId])
  @@index([createdById])
  @@index([status])
  @@map("equibs")
}

model EqubMember {
  id                String           @id @default(uuid())
  condoId           String?
  equbId            String
  equb              Equb             @relation(fields: [equbId], references: [id], onDelete: Cascade)
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            EqubMemberStatus @default(active)
  joinedAt          DateTime         @default(now())
  leftAt            DateTime?
  totalPaid         Decimal          @default(0) @db.Decimal(15, 2)
  hasReceivedPayout Boolean          @default(false)
  payoutCount       Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([equbId, userId])
  @@index([equbId])
  @@index([userId])
  @@index([status])
  @@map("equb_members")
}

model EqubPayout {
  id                 String           @id @default(uuid())
  equbId             String
  equb               Equb             @relation(fields: [equbId], references: [id], onDelete: Cascade)
  winnerId           String
  winner             User             @relation(fields: [winnerId], references: [id], onDelete: Restrict)
  createdById        String
  createdBy          User             @relation("PayoutCreator", fields: [createdById], references: [id], onDelete: Restrict)
  amount             Decimal          @db.Decimal(15, 2)
  roundNumber        Int
  selectionReference String           @unique
  status             EqubPayoutStatus @default(pending)
  selectedAt         DateTime?
  paidAt             DateTime?
  transactionId      String?          @unique
  transaction        Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([equbId, roundNumber])
  @@index([equbId])
  @@index([winnerId])
  @@index([status])
  @@map("equb_payouts")
}

model Iddir {
  id                 String        @id @default(uuid())
  condoId            String
  condo              Condo         @relation(fields: [condoId], references: [id], onDelete: Cascade)
  createdById        String
  createdBy          User          @relation("IddirCreator", fields: [createdById], references: [id], onDelete: Restrict)
  name               String
  noMembers          Int           @default(0)
  status             IddirStatus   @default(active)
  startedDate        DateTime
  contributionAmount Decimal       @db.Decimal(15, 2)
  members            IddirMember[]
  payments           Payment[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  @@index([condoId])
  @@index([createdById])
  @@index([status])
  @@map("iddirs")
}

model IddirMember {
  id            String            @id @default(uuid())
  iddirId       String
  iddir         Iddir             @relation(fields: [iddirId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        IddirMemberStatus @default(active)
  joinedAt      DateTime          @default(now())
  leftAt        DateTime?
  totalPaid     Decimal           @default(0) @db.Decimal(15, 2)
  totalReceived Decimal           @default(0) @db.Decimal(15, 2)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([iddirId, userId])
  @@index([iddirId])
  @@index([userId])
  @@index([status])
  @@map("iddir_members")
}

model UserAccount {
  id                   String        @id @default(uuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType          AccountType
  paymentMethod        PaymentMethod
  accountName          String
  accountNumber        String
  providerName         String?
  balance              Decimal       @default(0) @db.Decimal(15, 2)
  status               AccountStatus @default(active)
  isDefault            Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  sentTransactions     Transaction[] @relation("SenderAccount")
  receivedTransactions Transaction[] @relation("ReceiverAccount")

  @@unique([userId, accountNumber])
  @@index([userId])
  @@index([paymentMethod])
  @@index([status])
  @@map("user_accounts")
}

model CondoAccount {
  id                   String        @id @default(uuid())
  condoId              String
  condo                Condo         @relation(fields: [condoId], references: [id], onDelete: Cascade)
  accountType          AccountType
  paymentMethod        PaymentMethod
  accountName          String
  accountNumber        String
  providerName         String?
  balance              Decimal       @default(0) @db.Decimal(15, 2)
  status               AccountStatus @default(active)
  isDefault            Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  sentTransactions     Transaction[] @relation("CondoSenderAccount")
  receivedTransactions Transaction[] @relation("CondoReceiverAccount")

  @@unique([condoId, accountNumber])
  @@index([condoId])
  @@index([paymentMethod])
  @@index([status])
  @@map("condo_accounts")
}

model HXAccount {
  id                   String   @id @default(uuid())
  accountName          String
  accountNumber        String   @unique
  balance              Decimal  @default(0) @db.Decimal(15, 2)
  serviceFeePercentage Decimal  @default(0.34) @db.Decimal(5, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  transactions Transaction[]
  serviceFees  ServiceFee[]
}

model Payment {
  id String @id @default(uuid())

  userId String
  user   User   @relation("PaymentUser", fields: [userId], references: [id], onDelete: Cascade)

  condoId String
  condo   Condo  @relation(fields: [condoId], references: [id], onDelete: Cascade)

  equbId String?
  equb   Equb?   @relation(fields: [equbId], references: [id], onDelete: SetNull)

  iddirId String?
  iddir   Iddir?  @relation(fields: [iddirId], references: [id], onDelete: SetNull)

  paymentType PaymentType
  amount      Decimal     @db.Decimal(15, 2)
  serviceFee  Decimal     @default(0) @db.Decimal(15, 2)
  totalAmount Decimal     @db.Decimal(15, 2)

  monthYear String?

  paymentMethod PaymentMethod
  status        PaymentStatus @default(pending)

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  receiptUrl String?

  paymentDate DateTime?

  approvalDate DateTime?

  approvedById String?
  approvedBy   User?   @relation("PaymentApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([condoId])
  @@index([equbId])
  @@index([iddirId])
  @@index([paymentType])
  @@index([paymentMethod])
  @@index([status])
  @@index([monthYear])
  @@map("payments")
}

model Transaction {
  id String @id @default(uuid())

  senderId String?
  sender   User?   @relation("SenderTransaction", fields: [senderId], references: [id], onDelete: Restrict)

  senderAccountId String?
  senderAccount   UserAccount? @relation("SenderAccount", fields: [senderAccountId], references: [id], onDelete: SetNull)

  senderCondoAccountId String?
  senderCondoAccount   CondoAccount? @relation("CondoSenderAccount", fields: [senderCondoAccountId], references: [id], onDelete: SetNull)

  senderAccNo String?
  senderName  String?

  receiverId String?
  receiver   User?   @relation("ReceiverTransaction", fields: [receiverId], references: [id], onDelete: Restrict)

  receiverAccountId String?
  receiverAccount   UserAccount? @relation("ReceiverAccount", fields: [receiverAccountId], references: [id], onDelete: SetNull)

  receiverCondoAccountId String?
  receiverCondoAccount   CondoAccount? @relation("CondoReceiverAccount", fields: [receiverCondoAccountId], references: [id], onDelete: SetNull)

  hxAccountId   String?
  hxAccount     HXAccount? @relation(fields: [hxAccountId], references: [id])
  receiverAccNo String?
  receiverName  String?

  referenceNo String  @unique
  stamp       String?

  paymentType PaymentType?
  amount      Decimal      @db.Decimal(15, 2)
  monthYear   String?

  paymentMethod PaymentMethod?
  gateway       PaymentGateway @default(hx)

  status TransactionStatus @default(pending)

  condoId String?
  condo   Condo?  @relation(fields: [condoId], references: [id], onDelete: SetNull)

  payment    Payment?
  equbPayout EqubPayout?
  serviceFee ServiceFee?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([senderId])
  @@index([receiverId])
  @@index([senderAccountId])
  @@index([senderCondoAccountId])
  @@index([receiverAccountId])
  @@index([receiverCondoAccountId])
  @@index([condoId])
  @@index([referenceNo])
  @@index([status])
  @@index([paymentMethod])
  @@index([paymentType])
  @@map("transactions")
}

model ServiceFee {
  id            String      @id @default(uuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  condoId String
  condo   Condo  @relation(fields: [condoId], references: [id], onDelete: Cascade)

  hxAccountId String
  hxAccount   HXAccount @relation(fields: [hxAccountId], references: [id])
  percentage  Decimal   @db.Decimal(5, 2)
  baseAmount  Decimal   @db.Decimal(15, 2)
  feeAmount   Decimal   @db.Decimal(15, 2)

  status ServiceFeeStatus @default(pending)

  collectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([condoId])
  @@index([hxAccountId])
  @@index([status])
  @@map("service_fees")
}

model Announcement {
  id String @id @default(uuid())

  condoId String

  condo Condo @relation(fields: [condoId], references: [id], onDelete: Cascade)

  title String

  body String @db.Text

  announcementType AnnouncementType

  expiryDate DateTime?

  isPinned Boolean @default(false)

  createdById String

  createdBy User @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdByRole CreatorRole?

  imageUrl String?

  isPublic Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([condoId])
  @@index([createdById])
  @@index([announcementType])
  @@index([deletedAt])
  @@map("announcements")
}

model Report {
  id String @id @default(uuid())

  condoId String
  condo   Condo  @relation(fields: [condoId], references: [id], onDelete: Cascade)

  title       String
  description String         @db.Text
  category    ReportCategory
  photoUrl    String?
  status      ReportStatus   @default(reported)

  reporterId   String
  reporter     User         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reporterRole CreatorRole?

  priority     ReportPriority
  assignedToId String?
  assignedTo   User?          @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  resolvedAt      DateTime?
  resolutionNotes String?   @db.Text

  responses ReportResponse[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([condoId])
  @@index([reporterId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([deletedAt])
  @@map("reports")
}

model LostFound {
  id String @id @default(uuid())

  condoId String

  condo Condo @relation(fields: [condoId], references: [id], onDelete: Cascade)

  type LostFoundType

  userId String

  user User @relation("LostFoundUser", fields: [userId], references: [id], onDelete: Restrict)

  itemName String

  description String @db.Text

  category LostFoundCategory

  photoUrl String?

  location String?

  dateLostFound DateTime

  status LostFoundStatus @default(open)

  claimedById String?

  claimedBy User? @relation("LostFoundClaimant", fields: [claimedById], references: [id], onDelete: SetNull)

  claimVerified Boolean @default(false)

  verifiedById String?

  verifiedBy User? @relation("LostFoundVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([condoId])
  @@index([userId])
  @@index([claimedById])
  @@index([verifiedById])
  @@index([status])
  @@index([deletedAt])
  @@map("lost_and_found")
}

model ChatMessage {
  id         String    @id @default(uuid())
  condoId    String
  condo      Condo     @relation(fields: [condoId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User      @relation("ChatSender", fields: [senderId], references: [id], onDelete: Restrict)
  receiverId String
  receiver   User      @relation("ChatReceiver", fields: [receiverId], references: [id], onDelete: Restrict)
  type       ChatType
  content    String    @db.Text
  isRead     Boolean   @default(false)
  readAt     DateTime?
  editedAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([condoId])
  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@index([deletedAt])
  @@map("chat_messages")
}

model Promotion {
  id String @id @default(uuid())

  title       String
  description String    @db.Text
  type        PromoType
  category    String? // Simple category: 'electronics', 'fashion', 'food', etc.

  price    Decimal @db.Decimal(15, 2) // How much business paid
  currency String  @default("ETB")

  status   PromoStatus @default(pending)
  isActive Boolean     @default(true)

  reviewedById    String?
  reviewedBy      User?     @relation("PromotionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?   @db.Text

  businessName  String  @default("Unknown Business")
  contactPerson String?
  contactNumber String
  email         String?
  websiteUrl    String?

  imageUrl         String? // Main image
  additionalImages String[] // Additional images (Cloudinary URLs)

  expiresAt   DateTime
  publishedAt DateTime?

  condoId String?
  condo   Condo?  @relation(fields: [condoId], references: [id], onDelete: SetNull)

  postedById   String
  postedBy     User         @relation("PromotionPoster", fields: [postedById], references: [id], onDelete: Restrict)
  postedByRole CreatorRole?

  views  Int @default(0)
  clicks Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([isActive])
  @@index([expiresAt])
  @@index([type])
  @@index([condoId])
  @@index([postedById])
  @@index([deletedAt])
  @@map("promotions")
}

model ReportResponse {
  id String @id @default(uuid())

  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  message         String  @db.Text
  isAdminResponse Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@index([userId])
  @@map("report_responses")
}
