datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  resident
  condo_admin
  guard
  super_admin
}

enum RoomModel {
  studio
  one_bedroom
  two_bedroom
  three_bedroom
}

enum RoomStatus {
  free
  occupied
  reserved
}

enum EqubIddirStatus {
  pending
  active
  completed
  cancelled
}

enum ActiveInactiveStatus {
  active
  inactive
}

enum PaymentType {
  iddir
  equb
  guard_fee
  service_charge
  other
}

enum PaymentStatus {
  pending
  approved
  rejected
}

enum PaymentMethod {
  cbe
  telebirr
  cash
  bank_transfer
}

enum TransactionStatus {
  pending
  completed
  failed
}

enum AnnouncementType {
  general
  shop_alert
  emergency
  event
  mourning
  celebration
}

enum CreatorRole {
  admin
  guard
  resident
  super_admin
}

enum ReportCategory {
  plumbing
  electrical
  structural
  security
  noise
  other
}

enum ReportStatus {
  reported
  assigned
  in_progress
  resolved
  closed
}

enum ReportPriority {
  low
  medium
  high
  emergency
}

enum LostFoundType {
  lost
  found
}

enum LostFoundCategory {
  electronics
  documents
  keys
  clothing
  jewelry
  other
}

enum LostFoundStatus {
  open
  matched
  claimed
  archived
}

enum ChatType {
  message
  photo
  file
}

enum PromoType {
  shop
  technical
  other
}

model User {
  id           String  @id @default(uuid())
  fullName     String
  email        String  @unique
  phoneNumber  String  @unique
  password     String
  role         Role    @default(resident)

  condoId      String?
  condoCode    String?
  condo        Condo?  @relation(fields: [condoId], references: [id], onDelete: SetNull)

  block        String?
  roomNo       String?

  isVerified   Boolean @default(false)
  profilePhoto String?

  fan          String  @unique @db.VarChar(16)

  revenue      Decimal? @db.Decimal(15, 2)

  frontId      String?
  backId       String?

  isInIddir    Boolean @default(false)
  isInEqub     Boolean @default(false)
  isGetEqub    Boolean @default(false)

  refreshToken         String?   @unique
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  emailVerifyToken     String?   @unique
  emailVerifyExpires   DateTime?

  registerDate DateTime  @default(now())
  dueDate      DateTime?

  addToEqubById String?
  addToEqubBy   User?   @relation("UserAddToEqub", fields: [addToEqubById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  addedEqubUsers User[] @relation("UserAddToEqub")

  addToIddirById String?
  addToIddirBy   User?   @relation("UserAddToIddir", fields: [addToIddirById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  addedIddirUsers User[] @relation("UserAddToIddir")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roomsOccupied        Room[]         @relation("RoomOccupant")
  createdEquibs        Equb[]         @relation("EqubCreator")
  createdIddirs        Iddir[]        @relation("IddirCreator")
  paymentsMade         Payment[]      @relation("PaymentUser")
  paymentsApproved     Payment[]      @relation("PaymentApprover")
  sentTransactions     Transaction[]  @relation("SenderTransaction")
  receivedTransactions Transaction[]  @relation("ReceiverTransaction")
  announcements        Announcement[] @relation("AnnouncementCreator")
  reportsReported      Report[]       @relation("ReportReporter")
  reportsAssigned      Report[]       @relation("ReportAssignee")
  lostFoundReported    LostFound[]    @relation("LostFoundUser")
  lostFoundClaimed     LostFound[]    @relation("LostFoundClaimant")
  lostFoundVerified    LostFound[]    @relation("LostFoundVerifier")
  sentMessages         ChatMessage[]  @relation("ChatSender")
  receivedMessages     ChatMessage[]  @relation("ChatReceiver")
  promotionsPosted     Promotion[]    @relation("PromotionPoster")

  @@index([condoId])
  @@index([condoCode])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Condo {
  id               String    @id @default(uuid())
  condoCode        String    @unique @db.VarChar(50)
  condoName        String
  address          String
  city             String?
  gpsCoordinates   Json?
  maxAdmins        Int       @default(3)
  blockNumbers     String[]
  activeStatus     Boolean   @default(true)
  customSettings   Json?
  registrationDate DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  users         User[]
  blocks        Block[]
  rooms         Room[]
  equibs        Equb[]
  iddirs        Iddir[]
  payments      Payment[]
  announcements Announcement[]
  reports       Report[]
  lostAndFound  LostFound[]
  chatMessages  ChatMessage[]
  promotions    Promotion[]

  @@index([deletedAt])
  @@map("condos")
}

model Block {
  id             String   @id @default(uuid())
  condoId        String
  condo          Condo    @relation(fields: [condoId], references: [id], onDelete: Cascade)

  blockNo        String
  noRooms        Int
  noFloors       Int
  availableRooms Int      @default(0)
  occupiedRooms  Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rooms Room[]

  @@unique([condoId, blockNo])
  @@index([condoId])
  @@map("blocks")
}

model Room {
  id           String     @id @default(uuid())
  condoId      String
  condo        Condo      @relation(fields: [condoId], references: [id], onDelete: Cascade)

  blockId      String
  block        Block      @relation(fields: [blockId], references: [id], onDelete: Cascade)

  roomNo       String
  floorNo      Int
  price        Decimal    @db.Decimal(15, 2)
  model        RoomModel
  status       RoomStatus @default(free)

  occupiedById String?
  occupiedBy   User?      @relation("RoomOccupant", fields: [occupiedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([blockId, roomNo])
  @@index([condoId])
  @@index([blockId])
  @@index([occupiedById])
  @@map("rooms")
}

model Equb {
  id                 String          @id @default(uuid())
  condoId            String
  condo              Condo           @relation(fields: [condoId], references: [id], onDelete: Cascade)

  createdById        String
  createdBy          User            @relation("EqubCreator", fields: [createdById], references: [id], onDelete: Restrict)

  name               String
  noMembers          Int
  members            Json[]
  status             EqubIddirStatus @default(pending)
  startDate          DateTime
  dueDate            DateTime
  contributionAmount Decimal         @db.Decimal(15, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([condoId])
  @@index([createdById])
  @@index([status])
  @@map("equibs")
}

model Iddir {
  id                 String               @id @default(uuid())
  condoId            String
  condo              Condo                @relation(fields: [condoId], references: [id], onDelete: Cascade)

  createdById        String
  createdBy          User                 @relation("IddirCreator", fields: [createdById], references: [id], onDelete: Restrict)

  name               String
  noMembers          Int
  members            Json[]
  status             ActiveInactiveStatus @default(active)
  startedDate        DateTime
  contributionAmount Decimal              @db.Decimal(15, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([condoId])
  @@index([createdById])
  @@index([status])
  @@map("iddirs")
}

model Payment {
  id            String        @id @default(uuid())

  userId        String
  user          User          @relation("PaymentUser", fields: [userId], references: [id], onDelete: Cascade)

  condoId       String
  condo         Condo         @relation(fields: [condoId], references: [id], onDelete: Cascade)

  paymentType   PaymentType
  amount        Decimal       @db.Decimal(15, 2)
  monthYear     String
  status        PaymentStatus @default(pending)
  paymentMethod PaymentMethod

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  paymentDate  DateTime?
  adminNotes   String?
  approvedById String?
  approvedBy   User?         @relation("PaymentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([condoId])
  @@index([status])
  @@index([monthYear])
  @@index([deletedAt])
  @@map("payments")
}

model Transaction {
  id String @id @default(uuid())

  senderId String
  sender   User   @relation("SenderTransaction", fields: [senderId], references: [id], onDelete: Restrict)

  senderAccNo String
  senderName  String

  receiverId String
  receiver   User   @relation("ReceiverTransaction", fields: [receiverId], references: [id], onDelete: Restrict)

  receiverName  String
  receiverAccNo String

  referenceNo String  @unique
  stamp       String?

  payment Payment?

  paymentType   PaymentType?
  amount        Decimal         @db.Decimal(15, 2)
  monthYear     String?
  paymentMethod PaymentMethod?
  status        TransactionStatus @default(pending)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
  @@index([referenceNo])
  @@index([status])
  @@index([deletedAt])
  @@map("transactions")
}

model Announcement {
  id               String           @id @default(uuid())
  condoId          String
  condo            Condo            @relation(fields: [condoId], references: [id], onDelete: Cascade)

  title            String
  body             String           @db.Text
  announcementType AnnouncementType
  expiryDate       DateTime?
  isPinned         Boolean          @default(false)

  createdById String
  createdBy   User        @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdByRole CreatorRole?
  imageUrl      String?
  isPublic      Boolean      @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([condoId])
  @@index([createdById])
  @@index([announcementType])
  @@index([deletedAt])
  @@map("announcements")
}

model Report {
  id          String         @id @default(uuid())
  condoId     String
  condo       Condo          @relation(fields: [condoId], references: [id], onDelete: Cascade)

  title       String
  description String         @db.Text
  category    ReportCategory
  photoUrl    String?
  status      ReportStatus   @default(reported)

  reporterId String
  reporter   User           @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  reporterRole    CreatorRole?
  priority        ReportPriority
  assignedToId    String?
  assignedTo      User?          @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  resolutionNotes String?        @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([condoId])
  @@index([reporterId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([deletedAt])
  @@map("reports")
}

model LostFound {
  id            String            @id @default(uuid())
  condoId       String
  condo         Condo             @relation(fields: [condoId], references: [id], onDelete: Cascade)

  type          LostFoundType
  userId        String
  user          User              @relation("LostFoundUser", fields: [userId], references: [id], onDelete: Restrict)

  itemName      String
  description   String            @db.Text
  category      LostFoundCategory
  photoUrl      String?
  location      String?
  dateLostFound DateTime
  status        LostFoundStatus   @default(open)

  claimedById String?
  claimedBy   User?   @relation("LostFoundClaimant", fields: [claimedById], references: [id], onDelete: SetNull)

  claimVerified Boolean @default(false)

  verifiedById String?
  verifiedBy   User?   @relation("LostFoundVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([condoId])
  @@index([userId])
  @@index([claimedById])
  @@index([verifiedById])
  @@index([status])
  @@index([deletedAt])
  @@map("lost_and_found")
}

model ChatMessage {
  id         String    @id @default(uuid())
  condoId    String
  condo      Condo     @relation(fields: [condoId], references: [id], onDelete: Cascade)

  senderId   String
  sender     User      @relation("ChatSender", fields: [senderId], references: [id], onDelete: Restrict)

  receiverId String
  receiver   User      @relation("ChatReceiver", fields: [receiverId], references: [id], onDelete: Restrict)

  type      ChatType
  content   String    @db.Text
  isRead    Boolean   @default(false)
  readAt    DateTime?
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([condoId])
  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@index([deletedAt])
  @@map("chat_messages")
}

model Promotion {
  id          String    @id @default(uuid())
  condoId     String
  condo       Condo     @relation(fields: [condoId], references: [id], onDelete: Cascade)

  type        PromoType
  title       String
  description String    @db.Text
  price       Decimal   @db.Decimal(15, 2)

  postedById String
  postedBy   User      @relation("PromotionPoster", fields: [postedById], references: [id], onDelete: Restrict)

  postedByRole  CreatorRole?
  expiresAt     DateTime
  isActive      Boolean  @default(true)
  imageUrl      String?
  contactNumber String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([condoId])
  @@index([postedById])
  @@index([type])
  @@index([isActive])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("promotions")
}